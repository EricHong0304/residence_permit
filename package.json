{
  "name": "residence-permit-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["server", "admin", "app"],
  "scripts": {
    "prepare": "husky install",
    "format": "prettier -w .",
    "lint": "npm --workspace server run lint && npm --workspace admin run lint && npm --workspace app run lint",
    "lint:root": "eslint . --ext .js,.ts,.vue --ignore-path .gitignore",
    "test": "npm --workspace server run test",
    "build": "npm --workspace server run build && npm --workspace admin run build && npm --workspace app run build",
    "start:server": "npm --workspace server run start:dev",
    "dev:admin": "npm --workspace admin run dev",
    "dev:app": "npm --workspace app run dev",
    "preview:admin": "npm --workspace admin run preview",
    "preview:app": "npm --workspace app run preview"
  },
  "lint-staged": {
    "*.{js,ts,vue,css,scss,md,json,yml,yaml}": ["prettier --write"],
    "*.{js,ts,vue}": ["eslint --fix"]
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.27.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2"
  }
}
